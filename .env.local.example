# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI (Gemini) — free tier at aistudio.google.com
GOOGLE_AI_API_KEY=AIza...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...
# Sender shown to clients. The default (onboarding@resend.dev) only delivers to your own
# Resend account email; verify a domain in Resend and set this to email real clients.
# EMAIL_FROM=ProposalAI <hello@yourdomain.com>
# Client addresses are checked for typos and that the domain can receive mail (DNS lookup).
# Set to "off" to skip the DNS part, e.g. when working offline.
# EMAIL_DNS_CHECK=off

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local dev mocks (set to "true" to skip real API calls)
# MOCK_AI=true
# MOCK_PAYMENT=true
# MOCK_EMAIL=true
